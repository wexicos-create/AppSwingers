# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_FIREBASE_VAPID_KEY: clave publica Web Push para notificaciones push reales
# (alarma "hoy es tu evento"). Generela en Firebase Console → Configuracion del
# proyecto → Cloud Messaging → Certificados Web Push y configurela tambien en
# Vercel → Settings → Environment Variables.
VITE_FIREBASE_VAPID_KEY="MY_VAPID_PUBLIC_KEY"

# Cuenta de servicio de Firebase para el servidor de la alarma (api/event-day-alarm.js):
# Firebase Console → Configuracion del proyecto → Cuentas de servicio → Generar nueva clave privada.
# En Vercel configure estas tres variables (Production, Preview y Development):
FIREBASE_PROJECT_ID="appswinger-efa68"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@appswinger-efa68.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# CRON_SECRET: cadena aleatoria (16+ caracteres) que protege el endpoint de la
# alarma. Vercel la envia automaticamente en cada invocacion del cron
# (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET="MY_RANDOM_SECRET"

# FIREBASE_DATABASE_ID: identificador de la base de datos Firestore usada por el
# servidor de la alarma. Coincide con firestoreDatabaseId de firebase-applet-config.json.
FIREBASE_DATABASE_ID="(default)"
