rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for RBAC and ownership
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         request.auth.uid == "admin" ||
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    // Test connection rule
    match /test/connection {
      allow read: if true;
    }

    // Users collection with RBAC and privilege escalation prevention
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && (request.resource.data.isAdmin == null || request.resource.data.isAdmin == false);
      // The admin needs to publish identity verdicts (reject/ban) and account
      // flags on user documents; regular owners still cannot touch 'isAdmin'.
      allow update: if isAdmin() || (isOwner(userId) && (
        // Prevent regular users from elevating themselves to admin
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin'])) || 
        isAdmin()
      ));
      allow delete: if isAdmin() || isOwner(userId);

      // Subcollections owned by user
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Platform notifications: only the admin creates them (identity verdicts,
    // pass activations, system announcements); each user reads their own.
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userUid == request.auth.uid);
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Premium state-search day passes: only the admin activates them (after
    // approving the SPEI payment). The owner can read their own pass; a user
    // can never issue a pass to themselves.
    match /state_passes/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Matches collection: strictly validate participants
    match /matches/{matchId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.partnerId == request.auth.uid ||
        (resource.data.participants != null && request.auth.uid in resource.data.participants)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.partnerId == request.auth.uid ||
        (request.resource.data.participants != null && request.auth.uid in request.resource.data.participants)
      );
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.partnerId == request.auth.uid ||
        (resource.data.participants != null && request.auth.uid in resource.data.participants)
      );
      allow delete: if isAdmin();
    }

    // Reservations collection: strictly validate user ownership
    match /reservations/{reservationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // Proposals collection
    match /proposals/{proposalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );
    }

    // Reports collection: any authenticated user can create, only admin can read/manage
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // SPEI payment orders: users read only their own orders; only the admin validates, approves and rejects.
    // The bot performs automatic validation; the final decision and any status change require admin rights.
    match /spei_orders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userUid == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Organizer registration files: users create and read their own; only the admin approves or rejects.
    match /organizer_applications/{applicationId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userUid == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Virtual wallet transactions: users read only their own; buyers create earnings for organizers.
    match /wallet_transactions/{transactionId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userUid == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Withdrawal requests: users create and read their own; the admin processes them within the 24h SLA.
    match /withdrawal_requests/{withdrawalId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userUid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Legal INE archive: users create their own record; only the admin can review it.
    match /ine_records/{recordId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
