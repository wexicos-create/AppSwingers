rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    // Administrative access must be assigned server-side as a Firebase Auth custom claim.
    // Never trust a client-editable user document or a hard-coded UID for admin privileges.
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function protectedUserFields() {
      return ['isAdmin', 'admin', 'role', 'roles', 'status', 'accountStatus',
        'verify', 'verified', 'verificationStatus', 'subscriptionTier',
        'membershipStatus', 'paymentStatus', 'moderationStatus'];
    }

    match /test/connection {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{userId} {
      // Private user documents: only the owner and server-authorized admins can read them.
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(protectedUserFields());
      allow update: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields())
        && request.resource.data.uid == userId
      );
      allow delete: if isAdmin() || isOwner(userId);

      match /{subcollection}/{documentId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /{subcollection}/{documentId}/{nested=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /matches/{matchId} {
      allow read: if signedIn() && (
        request.auth.uid in resource.data.userIds
        || request.auth.uid == resource.data.userId
        || request.auth.uid == resource.data.partnerId
        || (resource.data.participants is list && request.auth.uid in resource.data.participants)
        || isAdmin()
      );
      allow create: if signedIn() && (
        (request.resource.data.userIds is list
          && request.auth.uid in request.resource.data.userIds
          && request.resource.data.userIds.size() == 2)
        || request.resource.data.userId == request.auth.uid
        || request.resource.data.partnerId == request.auth.uid
      );
      allow update: if signedIn() && (
        request.auth.uid in resource.data.userIds
        || request.auth.uid == resource.data.userId
        || request.auth.uid == resource.data.partnerId
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /reservations/{reservationId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'paid', 'paymentStatus', 'amountPaid']))
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid
        && resource.data.status in ['solicitud', 'pendiente_pago']);
    }

    match /proposals/{proposalId} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        request.resource.data.authorId == request.auth.uid
        || request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAdmin() || (signedIn() && (
        resource.data.authorId == request.auth.uid || resource.data.userId == request.auth.uid
      ));
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}