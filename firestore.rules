rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function accountIsActive(userId) {
      return !exists(/databases/$(database)/documents/users/$(userId)) ||
        (get(/databases/$(database)/documents/users/$(userId)).data.accountSecurity == null ||
         get(/databases/$(database)/documents/users/$(userId)).data.accountSecurity.status != 'banned');
    }

    function canUseAccount() {
      return isAuthenticated() && accountIsActive(request.auth.uid);
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    match /test/connection {
      allow read: if true;
    }

    match /users/{userId} {
      allow read: if canUseAccount();
      allow create: if isOwner(userId) &&
        (request.resource.data.isAdmin == null || request.resource.data.isAdmin == false) &&
        !request.resource.data.keys().hasAny(['identityVerification', 'accountSecurity']);
      allow update: if isOwner(userId) && accountIsActive(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isAdmin', 'identityVerification', 'accountSecurity']);
      allow delete: if isAdmin() || (isOwner(userId) && accountIsActive(userId));

      match /swipes/{swipeId} {
        allow read, write: if isOwner(userId) && accountIsActive(userId);
      }
      match /matches/{matchId} {
        allow read, write: if isOwner(userId) && accountIsActive(userId);
      }
      match /deviceRegistry/{deviceId} {
        allow read, write: if false;
      }
    }

    match /matches/{matchId} {
      allow read: if canUseAccount() && (
        resource.data.userId == request.auth.uid ||
        resource.data.partnerId == request.auth.uid ||
        (resource.data.participants != null && request.auth.uid in resource.data.participants)
      );
      allow create: if canUseAccount() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.partnerId == request.auth.uid ||
        (request.resource.data.participants != null && request.auth.uid in request.resource.data.participants)
      );
      allow update: if canUseAccount() && (
        resource.data.userId == request.auth.uid ||
        resource.data.partnerId == request.auth.uid ||
        (resource.data.participants != null && request.auth.uid in resource.data.participants)
      );
      allow delete: if isAdmin();
    }

    match /reservations/{reservationId} {
      allow read: if canUseAccount() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if canUseAccount() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if canUseAccount() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    match /proposals/{proposalId} {
      allow read: if canUseAccount();
      allow create: if canUseAccount();
      allow update, delete: if canUseAccount() && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );
    }

    match /reports/{reportId} {
      allow create: if canUseAccount() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // The Admin SDK APIs are the only writers/readers for security audit data.
    match /securityCases/{caseId} {
      allow read, write: if false;
    }
    match /diditWebhookEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
