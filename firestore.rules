rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    // Admin authority must be granted by a trusted Admin SDK process as a custom claim.
    // Never trust a user-editable Firestore field or a client-side PIN/password.
    function admin() { return signedIn() && request.auth.token.admin == true; }

    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      // Until public profile fields are migrated to /publicProfiles, do not expose
      // account documents containing email, moderation, or billing data to all users.
      allow get: if owner(uid) || admin();
      allow list: if admin();
      allow create: if owner(uid)
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && (!('subscription' in request.resource.data) || request.resource.data.subscription == 'free')
        && (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false);
      allow update: if owner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isAdmin', 'role', 'subscription', 'subscriptionStatus',
          'isVerified', 'verificationStatus', 'paymentStatus', 'balance'
        ]);
      allow delete: if owner(uid) || admin();

      match /swipes/{swipeId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.fromUserId == uid
          && request.resource.data.swipeType in ['like', 'dislike', 'pass', 'superlike']
          && request.resource.data.keys().hasOnly(['fromUserId', 'toUserId', 'swipeType', 'timestamp'])
          && request.resource.data.toUserId is string
          && request.resource.data.toUserId != uid;
        allow update, delete: if false;
      }
      // Private per-user cache only. A trusted backend must create mutual matches.
      match /matches/{matchId} {
        allow read: if owner(uid);
        allow write: if false;
      }
      match /{nested=**} {
        allow read, write: if false;
      }
    }

    // Client writes cannot create or alter a match without verified mutual consent.
    match /matches/{matchId} {
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.partnerId == request.auth.uid ||
         (resource.data.participants is list && request.auth.uid in resource.data.participants));
      allow create, update, delete: if false;
    }

    match /reservations/{reservationId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['solicitud', 'pendiente_pago']
        && !('paid' in request.resource.data || 'paymentStatus' in request.resource.data);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        && request.resource.data.status == 'cancelado';
      allow delete: if admin();
    }

    match /proposals/{proposalId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'en revisión'
        && request.resource.data.keys().hasOnly([
          'authorId', 'title', 'cat', 'author', 'when', 'apps', 'status', 'body', 'createdAt'
        ]);
      allow update: if signedIn() && resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'when']);
      allow delete: if admin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasOnly(['reporterId', 'target', 'reason', 'details', 'createdAt', 'status']);
      allow read, update, delete: if admin();
    }

    // Billing records and entitlement grants are server-only.
    match /payments/{paymentId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /subscriptions/{subscriptionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}