rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'superadmin'
      );
    }
    function safeUserCreate() {
      return !request.resource.data.keys().hasAny([
        'isAdmin', 'role', 'admin', 'membership', 'membershipExpiresAt',
        'verified', 'verify', 'kycStatus', 'paymentStatus', 'balance'
      ]);
    }

    match /test/connection {
      allow read: if signedIn();
      allow write: if false;
    }

    // User documents: private by default; privilege and verification fields are server-managed.
    match /users/{userId} {
      allow create: if owns(userId) && safeUserCreate();
      allow read: if owns(userId) || isAdmin();
      allow update: if (owns(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isAdmin', 'role', 'admin', 'membership', 'membershipExpiresAt',
          'verified', 'verify', 'kycStatus', 'paymentStatus', 'balance',
          'suspended', 'accountStatus'
        ])) || isAdmin();
      allow delete: if isAdmin();

      match /swipes/{swipeId} {
        allow read, create: if owns(userId);
        allow update, delete: if false;
      }
      match /matches/{matchId} {
        allow read: if owns(userId);
        allow create: if owns(userId) &&
          request.resource.data.userIds is list &&
          request.auth.uid in request.resource.data.userIds;
        allow update: if owns(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage', 'updatedAt', 'readAt', 'unreadCount'
          ]);
        allow delete: if owns(userId);
      }
      match /{subcollection}/{documentId} {
        allow read, write: if false;
      }
    }

    // Orders are created pending by their owner. Only trusted server/admin can confirm/refund.
    match /orders/{orderId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pendiente' &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.reference is string &&
        request.resource.data.reference.size() >= 12;
      allow read: if signedIn() && resource.data.userId == request.auth.uid || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Membership grants and expiry timestamps are never client-writable.
    match /memberships/{membershipId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Identity/KYC submissions: owner may submit and read their own request; only admin may review.
    match /identityVerifications/{verificationId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'en_revision';
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // User complaints, reports and agency partnership requests.
    match /reports/{reportId} {
      allow create: if signedIn() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.status == 'abierto' &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 3;
      allow read, update, delete: if isAdmin();
    }
    match /supportTickets/{ticketId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'abierto' &&
        request.resource.data.message is string &&
        request.resource.data.message.size() >= 3;
      allow read, update, delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }
    match /agencyApplications/{applicationId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pendiente';
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Match records: participants may read; participants cannot rewrite the participant list.
    match /matches/{matchId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.partnerId == request.auth.uid ||
        (resource.data.participants is list && request.auth.uid in resource.data.participants)
      );
      allow create: if signedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.partnerId == request.auth.uid ||
        (request.resource.data.participants is list && request.auth.uid in request.resource.data.participants)
      );
      allow update: if signedIn() &&
        (resource.data.userId == request.auth.uid || resource.data.partnerId == request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'userId', 'partnerId', 'participants', 'status', 'moderationStatus'
        ]);
      allow delete: if isAdmin();
    }

    match /reservations/{reservationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid &&
        request.resource.data.status in ['solicitud', 'pendiente_pago'];
      allow update, delete: if isAdmin();
    }

    match /proposals/{proposalId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.status == 'en revisión';
      allow update: if isAdmin() || (signedIn() &&
        resource.data.authorId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'updatedAt']));
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    // Deny every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}